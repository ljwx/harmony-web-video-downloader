// Ported from JdcrKmpApp WebMediaPageExtraction.kt; executes only inside ArkWeb.
export const VIDEO_SCRIPT: string = "\n    (function() {\n        const urls = [];\n        const seenUrls = new Set();\n        const normalizeUrl = function(value) {\n            if (typeof value !== 'string') return '';\n            let normalized = value.trim()\n                .replace(/\\\\u002[fF]/g, '/')\n                .replace(/\\\\u0026/g, '&')\n                .replace(/\\\\x2[fF]/g, '/')\n                .replace(/\\\\\\//g, '/')\n                .replace(/&amp;/gi, '&');\n            if (/^https?%3[aA]/.test(normalized)) {\n                try { normalized = decodeURIComponent(normalized); } catch (_) {}\n            }\n            if (normalized.startsWith('//')) normalized = location.protocol + normalized;\n            return normalized;\n        };\n        const isVideoUrl = function(value) {\n            return value.startsWith('blob:') ||\n                /\\.(mp4|m4v|webm|mov|3gp|m3u8|mpd)([?#]|$)/i.test(value) ||\n                /\\/video\\/tos\\/|mime_type=video_|video_id=|douyinvod|ibytedtos/i.test(value);\n        };\n        const addUrl = function(value) {\n            const normalized = normalizeUrl(value);\n            if (!/^(https?:\\/\\/|blob:)/i.test(normalized) || !isVideoUrl(normalized) || seenUrls.has(normalized)) return;\n            seenUrls.add(normalized);\n            urls.push(normalized);\n        };\n        const videoVisibility = function(video) {\n            const rect = video.getBoundingClientRect();\n            return Math.max(0, Math.min(rect.right, innerWidth) - Math.max(rect.left, 0)) *\n                Math.max(0, Math.min(rect.bottom, innerHeight) - Math.max(rect.top, 0));\n        };\n        const videos = Array.from(document.querySelectorAll('video')).sort(function(left, right) {\n            const leftPlaying = !left.paused && !left.ended ? 1 : 0;\n            const rightPlaying = !right.paused && !right.ended ? 1 : 0;\n            return rightPlaying - leftPlaying || videoVisibility(right) - videoVisibility(left);\n        });\n        const activeVideo = videos.find(function(video) {\n            return !video.paused && !video.ended;\n        }) || videos.find(function(video) { return videoVisibility(video) > 0; });\n        const activeUrl = activeVideo ? normalizeUrl(activeVideo.currentSrc || activeVideo.src || '') : '';\n        videos.forEach(function(video) {\n            if (video.currentSrc) addUrl(video.currentSrc);\n            if (video.src) addUrl(video.src);\n            video.querySelectorAll('source').forEach(function(source) {\n                if (source.src) addUrl(source.src);\n            });\n        });\n        performance.getEntriesByType('resource').slice().reverse().forEach(function(entry) {\n            addUrl(entry.name || '');\n        });\n\n        // Douyin image posts can render only a static cover in WebView while keeping the\n        // motion-photo MP4 in hydration data. Inspect only the current post's data object.\n        if (/(^|\\.)(?:douyin|iesdouyin)\\.com$/i.test(location.hostname)) {\n            const currentId = (function() {\n                try {\n                    const pageUrl = new URL(location.href);\n                    const queryId = pageUrl.searchParams.get('modal_id') || pageUrl.searchParams.get('aweme_id');\n                    if (queryId) return queryId;\n                    const pathMatch = pageUrl.pathname.match(/\\/(?:share\\/)?(?:video|note|slides)\\/([^/?#]+)/i);\n                    return pathMatch ? pathMatch[1] : '';\n                } catch (_) {\n                    return '';\n                }\n            })();\n            const visited = new WeakSet();\n            let remainingNodes = 50000;\n            const collectMediaUrls = function(value, depth) {\n                if (remainingNodes-- <= 0 || depth > 14 || value == null) return;\n                if (typeof value === 'string') {\n                    addUrl(value);\n                    const nested = value.trim();\n                    if (nested.length > 1 && nested.length < 1000000 &&\n                        ((nested[0] === '{' && nested[nested.length - 1] === '}') ||\n                            (nested[0] === '[' && nested[nested.length - 1] === ']'))) {\n                        try { collectMediaUrls(JSON.parse(nested), depth + 1); } catch (_) {}\n                    }\n                    return;\n                }\n                if (typeof value !== 'object' || visited.has(value)) return;\n                visited.add(value);\n                Object.keys(value).forEach(function(key) {\n                    collectMediaUrls(value[key], depth + 1);\n                });\n            };\n            const idKeys = /^(aweme_?id|item_?id|group_?id)$/i;\n            const findCurrentPostData = function(value, depth, targets) {\n                if (depth > 14 || value == null || typeof value !== 'object') return;\n                if (Array.isArray(value)) {\n                    value.forEach(function(item) { findCurrentPostData(item, depth + 1, targets); });\n                    return;\n                }\n                const keys = Object.keys(value);\n                const matchesId = currentId && keys.some(function(key) {\n                    return idKeys.test(key) && String(value[key]) === currentId;\n                });\n                if (matchesId) targets.push(value);\n                keys.forEach(function(key) {\n                    const child = value[key];\n                    if (currentId && key === currentId && child && typeof child === 'object') targets.push(child);\n                    findCurrentPostData(child, depth + 1, targets);\n                });\n            };\n            const collectMotionPhotoSections = function(value, depth) {\n                if (depth > 14 || value == null || typeof value !== 'object') return;\n                Object.keys(value).forEach(function(key) {\n                    const child = value[key];\n                    if (/live_?photo|motion_?photo|dynamic_?photo/i.test(key)) {\n                        collectMediaUrls(child, depth + 1);\n                    } else {\n                        collectMotionPhotoSections(child, depth + 1);\n                    }\n                });\n            };\n            const decodeDataText = function(raw) {\n                let decoded = (raw || '').trim();\n                if (/^(%7[bB]|%5[bB])/.test(decoded)) {\n                    try { decoded = decodeURIComponent(decoded); } catch (_) {}\n                }\n                return decoded;\n            };\n            const collectCurrentPostMedia = function(data) {\n                const targets = [];\n                findCurrentPostData(data, 0, targets);\n                if (targets.length > 0) {\n                    targets.forEach(function(target) { collectMediaUrls(target, 0); });\n                } else {\n                    collectMotionPhotoSections(data, 0);\n                }\n            };\n            const extractUrlsNearCurrentPost = function(text) {\n                const normalized = normalizeUrl(text);\n                const regions = [];\n                if (currentId) {\n                    let index = normalized.indexOf(currentId);\n                    while (index >= 0 && regions.length < 4) {\n                        regions.push(normalized.slice(Math.max(0, index - 30000), index + 200000));\n                        index = normalized.indexOf(currentId, index + currentId.length);\n                    }\n                }\n                const motionMatch = /live_?photo|motion_?photo|dynamic_?photo/i.exec(normalized);\n                if (motionMatch) {\n                    regions.push(normalized.slice(Math.max(0, motionMatch.index - 10000), motionMatch.index + 100000));\n                }\n                regions.forEach(function(region) {\n                    (region.match(/https?:\\/\\/[^\\s\\\"'<>\\\\]+/gi) || []).forEach(addUrl);\n                });\n            };\n            document.querySelectorAll('script').forEach(function(script) {\n                if (script.src) return;\n                const raw = script.textContent || '';\n                if (!raw || raw.length > 8000000) return;\n                const isDataScript = /json/i.test(script.type || '') ||\n                    /render|initial|universal|state|next|hydration/i.test(script.id || '');\n                if (!isDataScript &&\n                    !/aweme_?id|live_?photo|motion_?photo|dynamic_?photo|play_?addr|\\/video\\/tos\\//i.test(raw)) {\n                    return;\n                }\n                const decoded = decodeDataText(raw);\n                let parsed = null;\n                try { parsed = JSON.parse(decoded); } catch (_) {}\n                if (parsed != null) {\n                    collectCurrentPostMedia(parsed);\n                } else {\n                    extractUrlsNearCurrentPost(decoded);\n                }\n            });\n            (window.__jdcrExtractedMediaUrls || []).forEach(addUrl);\n            const slidesInfoUrl = performance.getEntriesByType('resource')\n                .map(function(entry) { return entry.name || ''; })\n                .find(function(url) { return /\\/web\\/api\\/v2\\/aweme\\/slidesinfo\\//i.test(url); });\n            if (slidesInfoUrl && !window.__jdcrSlidesInfoExtractionPending) {\n                window.__jdcrSlidesInfoExtractionPending = true;\n                fetch(slidesInfoUrl, { credentials: 'include' })\n                    .then(function(response) { return response.ok ? response.json() : null; })\n                    .then(function(data) {\n                        if (data) collectCurrentPostMedia(data);\n                        window.__jdcrExtractedMediaUrls = Array.from(new Set(\n                            (window.__jdcrExtractedMediaUrls || []).concat(urls)\n                        ));\n                    })\n                    .catch(function() {})\n                    .finally(function() { window.__jdcrSlidesInfoExtractionPending = false; });\n            }\n        }\n        return JSON.stringify({ urls: urls, activeUrl: activeUrl });\n    })();\n";
